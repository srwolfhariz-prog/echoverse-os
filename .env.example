# OpenAI-compatible GPT provider.
# For third-party GPT API vendors, set GPT_BASE_URL to their /v1 endpoint.
GPT_API_KEY="your_gpt_api_key"
GPT_BASE_URL="https://your-provider.example/v1"
GPT_MODEL="gpt-4.1-mini"
GPT_PROVIDER="openai-compatible"
GPT_TIMEOUT_MS="45000"
GPT_MAX_RETRIES="1"
GPT_RESPONSE_FORMAT="json_object"

# Backward-compatible fallback. Leave empty if you use GPT_* above.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""
